{%- comment -%}
  Your Video Frome: turns a customer's own video into a Frome and sells the digital file.
  The generator runs inside a same-origin iframe so theme styles and generator styles stay separate.
  Server: see the frome-custom repository (Netlify). Built from the prototype by theme-build/build.py.
{%- endcomment -%}
{%- assign vf_product = all_products[section.settings.product_handle] -%}
{%- assign vf_variant = vf_product.selected_or_first_available_variant | default: vf_product.variants.first -%}
{%- if vf_variant -%}{%- assign vf_price = vf_variant.price | money -%}{%- assign vf_variant_id = vf_variant.id -%}
{%- else -%}{%- assign vf_price = section.settings.price_text -%}{%- assign vf_variant_id = section.settings.variant_id -%}{%- endif -%}
<div class="video-frome-embed" id="vf-{{ section.id }}"
  data-api="{{ section.settings.api_url | escape }}" data-variant="{{ vf_variant_id }}"
  data-cart-add="{{ routes.cart_add_url }}.js" data-cart="{{ routes.cart_url }}" data-price="{{ vf_price | strip_html | escape }}">
  <iframe title="Your Video Frome generator" loading="eager" style="display:block;width:100%;height:100vh;min-height:640px;border:0;background:#17151a"></iframe>
  <noscript><p style="padding:24px">This tool needs JavaScript turned on.</p></noscript>
</div>
<script type="application/json" id="vf-doc-{{ section.id }}">{% raw %}"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Your Video Frome<\/title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=IBM+Plex+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  /* Layout idea: a dim screening room. Controls in a narrow left rail, the canvas hung on a wall panel to the right.\n     Single theme by choice: the stripes are the only saturated color on the page. */\n  :root {\n    color-scheme: dark;\n    --room: #17151a;        /* page background, slightly plum so stripes read warm */\n    --panel: #211e26;       /* control rail and cards */\n    --wall: #2b2731;        /* wall behind the canvas */\n    --line: #3a3542;        /* borders */\n    --text: #f1edf3;        /* primary text */\n    --muted: #a9a2b3;       /* secondary text */\n    --lamp: #f2b56b;        /* projector-lamp accent */\n    --lamp-ink: #2a1c08;    /* text on accent */\n    --warn: #ff9c8a;        /* errors */\n    --display: \"Bricolage Grotesque\", \"Segoe UI\", system-ui, sans-serif;\n    --body: \"IBM Plex Sans\", \"Segoe UI\", system-ui, sans-serif;\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; height: 100%; }\n  body {\n    background: var(--room);\n    color: var(--text);\n    font-family: var(--body);\n    font-size: 15px;\n    line-height: 1.5;\n  }\n  .page { max-width: 1240px; margin: 0 auto; padding: 28px 20px 48px; display: flex; flex-direction: column; gap: 24px; }\n  header { display: flex; flex-direction: column; gap: 8px; max-width: 62ch; }\n  .tag {\n    align-self: flex-start; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;\n    color: var(--lamp); border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px;\n  }\n  h1 { font-family: var(--display); font-weight: 700; font-size: clamp(28px, 4vw, 40px); line-height: 1.1; margin: 0; text-wrap: balance; }\n  header p { margin: 0; color: var(--muted); }\n\n  .work { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 24px; align-items: start; }\n  @media (max-width: 880px) { .work { grid-template-columns: minmax(0, 1fr); } .stage { order: -1; } }\n\n  .rail { display: flex; flex-direction: column; gap: 14px; }\n  .card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px; display: flex; flex-direction: column; gap: 12px; }\n  .card h2 { font-family: var(--display); font-weight: 500; font-size: 17px; margin: 0; display: flex; gap: 10px; align-items: baseline; }\n  .card h2 span { color: var(--lamp); font-variant-numeric: tabular-nums; font-size: 13px; }\n  .hint { color: var(--muted); font-size: 13px; margin: 0; }\n\n  .btn {\n    display: inline-flex; align-items: center; justify-content: center; gap: 8px;\n    font: 600 14px var(--body); color: var(--text); background: transparent;\n    border: 1px solid var(--line); border-radius: 8px; padding: 9px 14px; cursor: pointer;\n  }\n  .btn:hover { border-color: var(--muted); }\n  .btn.primary { background: var(--lamp); color: var(--lamp-ink); border-color: var(--lamp); }\n  .btn.primary:hover { filter: brightness(1.06); }\n  .btn.buy { width: 100%; padding: 13px 14px; font-size: 16px; }\n  .fine { color: var(--muted); font-size: 12px; margin: 0; }\n  .btn[disabled] { opacity: .45; cursor: not-allowed; }\n  .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n  input[type=\"file\"] { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }\n  label.btn:focus-within, .btn:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid var(--lamp); outline-offset: 2px; }\n\n  .field { display: flex; flex-direction: column; gap: 4px; }\n  .field > label, .field > .lab { font-size: 13px; color: var(--muted); display: flex; justify-content: space-between; gap: 8px; }\n  .field output { color: var(--text); font-variant-numeric: tabular-nums; }\n  input[type=\"range\"] { width: 100%; accent-color: var(--lamp); margin: 0; }\n  input[type=\"text\"], select {\n    font: 400 14px var(--body); color: var(--text); background: var(--room);\n    border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; width: 100%;\n  }\n  .check { display: flex; gap: 8px; align-items: center; font-size: 14px; }\n  .check input { accent-color: var(--lamp); width: 16px; height: 16px; margin: 0; }\n  .seg { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }\n  .seg label { text-align: center; font-size: 13px; padding: 7px 4px; cursor: pointer; color: var(--muted); border-left: 1px solid var(--line); }\n  .seg label:first-of-type { border-left: 0; }\n  .seg input { position: absolute; opacity: 0; pointer-events: none; }\n  .seg input:checked + label { background: var(--lamp); color: var(--lamp-ink); font-weight: 600; }\n  .seg input:focus-visible + label { outline: 2px solid var(--lamp); outline-offset: -2px; }\n  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; display: flex; flex-direction: column; gap: 12px; }\n  fieldset[disabled] { opacity: .45; }\n\n  .progress { height: 6px; border-radius: 3px; background: var(--room); overflow: hidden; }\n  .progress i { display: block; height: 100%; width: 0; background: var(--lamp); }\n  .status { font-size: 13px; color: var(--muted); margin: 0; min-height: 1.5em; }\n  .status.err { color: var(--warn); }\n\n  .stage { display: flex; flex-direction: column; gap: 12px; position: sticky; top: 16px; }\n  @media (max-width: 880px) { .stage { top: 0; z-index: 5; background: var(--room); padding: 8px 0; margin: -8px 0; } .wall { padding: 12px; } .meta span:last-child { display: none; } }\n  .wall {\n    background: radial-gradient(120% 90% at 50% 0%, #37323f 0%, var(--wall) 55%, #221f27 100%);\n    border: 1px solid var(--line); border-radius: 12px; padding: clamp(18px, 5vw, 56px);\n  }\n  canvas#view { display: block; width: 100%; height: auto; aspect-ratio: 5 / 2; border-radius: 2px; box-shadow: 0 18px 40px rgba(0,0,0,.55), 0 2px 0 rgba(255,255,255,.06) inset; background: #000; }\n  .meta { display: flex; flex-wrap: wrap; gap: 8px 16px; justify-content: space-between; align-items: center; color: var(--muted); font-size: 13px; }\n  .chip { border: 1px solid var(--line); border-radius: 999px; padding: 2px 10px; font-size: 12px; color: var(--text); }\n  .chip.sample { color: var(--lamp); }\n  @media (prefers-reduced-motion: no-preference) { .progress i { transition: width .15s linear; } }\n<\/style>\n<\/head>\n<body>\n<div class=\"page\">\n  <header>\n    <h1>Turn your own video into a Frome<\/h1>\n    <p>Each stripe is the average color of one moment in your video, in order from the first frame to the last. Add a photo and it sits behind the color as a faded background. Your video never leaves this device. If you order, we receive only the colors and, if you add one, your photo.<\/p>\n  <\/header>\n\n  <div class=\"work\">\n    <div class=\"rail\">\n      <section class=\"card\" aria-labelledby=\"h-video\">\n        <h2 id=\"h-video\"><span>1<\/span>Your video<\/h2>\n        <div class=\"row\">\n          <label class=\"btn primary\" for=\"videoFile\">Choose video<input type=\"file\" id=\"videoFile\" accept=\"video/*\"><\/label>\n          <button class=\"btn\" type=\"button\" id=\"useSample\">Use sample<\/button>\n        <\/div>\n        <div class=\"progress\" aria-hidden=\"true\"><i id=\"bar\"><\/i><\/div>\n        <p class=\"status\" id=\"videoStatus\" role=\"status\">Showing a sample palette. MP4 and MOV files work best.<\/p>\n        <div class=\"field\">\n          <label for=\"detail\">Stripes <output id=\"detailOut\" for=\"detail\">1500 \u00b7 Frome standard<\/output><\/label>\n          <input type=\"range\" id=\"detail\" min=\"60\" max=\"1500\" step=\"20\" value=\"1500\">\n        <\/div>\n        <label class=\"check\" for=\"smooth\"><input type=\"checkbox\" id=\"smooth\">Blend stripes into a smooth gradient<\/label>\n      <\/section>\n\n      <section class=\"card\" aria-labelledby=\"h-photo\">\n        <h2 id=\"h-photo\"><span>2<\/span>Background photo<\/h2>\n        <div class=\"row\">\n          <label class=\"btn\" for=\"photoFile\">Choose photo<input type=\"file\" id=\"photoFile\" accept=\"image/*\"><\/label>\n          <button class=\"btn\" type=\"button\" id=\"removePhoto\">Remove photo<\/button>\n        <\/div>\n        <p class=\"status\" id=\"photoStatus\" role=\"status\">Showing a sample photo.<\/p>\n        <fieldset id=\"photoControls\">\n          <div class=\"field\">\n            <span class=\"lab\">Style<\/span>\n            <div class=\"seg\" role=\"radiogroup\" aria-label=\"Photo style\">\n              <input type=\"radio\" name=\"blend\" id=\"blendTint\" value=\"luminosity\" checked><label for=\"blendTint\">Tinted<\/label>\n              <input type=\"radio\" name=\"blend\" id=\"blendFade\" value=\"source-over\"><label for=\"blendFade\">Faded<\/label>\n              <input type=\"radio\" name=\"blend\" id=\"blendSoft\" value=\"soft-light\"><label for=\"blendSoft\">Soft light<\/label>\n            <\/div>\n          <\/div>\n          <div class=\"field\">\n            <label for=\"strength\">Photo strength <output id=\"strengthOut\" for=\"strength\">45%<\/output><\/label>\n            <input type=\"range\" id=\"strength\" min=\"5\" max=\"90\" step=\"1\" value=\"45\">\n          <\/div>\n          <div class=\"field\">\n            <label for=\"zoom\">Zoom <output id=\"zoomOut\" for=\"zoom\">1.0\u00d7<\/output><\/label>\n            <input type=\"range\" id=\"zoom\" min=\"60\" max=\"300\" step=\"5\" value=\"100\">\n          <\/div>\n          <div class=\"field\">\n            <label for=\"posX\">Move left / right<\/label>\n            <input type=\"range\" id=\"posX\" min=\"0\" max=\"100\" step=\"1\" value=\"50\">\n          <\/div>\n          <div class=\"field\">\n            <label for=\"posY\">Move up / down<\/label>\n            <input type=\"range\" id=\"posY\" min=\"0\" max=\"100\" step=\"1\" value=\"50\">\n          <\/div>\n          <label class=\"check\" for=\"edgeFade\"><input type=\"checkbox\" id=\"edgeFade\" checked>Fade the photo out toward its edges<\/label>\n        <\/fieldset>\n      <\/section>\n\n      <section class=\"card\" aria-labelledby=\"h-finish\">\n        <h2 id=\"h-finish\"><span>3<\/span>Finish<\/h2>\n        <div class=\"field\">\n          <label for=\"caption\">Caption (optional)<\/label>\n          <input type=\"text\" id=\"caption\" maxlength=\"60\" value=\"Maya &amp; Daniel \u00b7 June 14, 2025\" autocomplete=\"off\">\n        <\/div>\n        <label class=\"check\" for=\"finish\"><input type=\"checkbox\" id=\"finish\" checked>Frome finish: fade to dark at top and bottom<\/label>\n        <button class=\"btn primary buy\" type=\"button\" id=\"buy\" disabled>Buy the digital file \u00b7 __VF_PRICE__<\/button>\n        <p class=\"status\" id=\"buyStatus\" role=\"status\">Choose your own video to order.<\/p>\n        <p class=\"fine\">You get a 9000 \u00d7 3600 pixel file, as a JPG and a PNG, with no watermark. The download link arrives in your order confirmation email, usually within a minute of payment. Digital files are non-refundable once delivered; if yours is faulty we re-render it free.<\/p>\n        <div class=\"row\">\n          <button class=\"btn\" type=\"button\" id=\"save\">Save watermarked preview<\/button>\n        <\/div>\n        <p class=\"hint\" id=\"saveStatus\" role=\"status\"><\/p>\n      <\/section>\n    <\/div>\n\n    <div class=\"stage\">\n      <div class=\"wall\"><canvas id=\"view\" width=\"1500\" height=\"600\" aria-label=\"Preview of your video palette canvas\"><\/canvas><\/div>\n      <div class=\"meta\">\n        <span><span class=\"chip sample\" id=\"sourceChip\">Sample palette<\/span> <span id=\"sourceNote\">A wedding day, morning to night<\/span><\/span>\n        <span>Canvas shape 5 : 2, as in 30\u00d712 in and 40\u00d716 in<\/span>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/div>\n\n<script>\n/* ---- shared renderer: identical to the file the server uses for the delivered image ---- */\n/* Frome video palette renderer.\n   One drawing routine for both the browser preview and the server's print-size file, so the two always match.\n   Everything is sized relative to the canvas, so the same design renders at 1500x600 or 9000x3600.\n\n   design = {\n     colors:   [[r,g,b], ...]   one per time slice, first frame to last\n     settings: { detail, smooth, blend, strength, zoom, posX, posY, edgeFade, finish, caption }\n   }\n   photo  = anything drawImage accepts (HTMLImageElement, canvas, napi Image), or null\n   opts   = { makeCanvas(w,h), watermark:boolean, captionFont:string } */\n(function (root, factory) {\n  if (typeof module === \"object\" && module.exports) module.exports = factory();\n  else root.FromeDraw = factory();\n})(typeof self !== \"undefined\" ? self : this, function () {\n  \"use strict\";\n\n  var BLENDS = { \"luminosity\": 1, \"source-over\": 1, \"soft-light\": 1 };\n\n  function clamp(v, lo, hi, dflt) { v = Number(v); if (!isFinite(v)) return dflt; return Math.max(lo, Math.min(hi, v)); }\n\n  /* Accept only known fields in known ranges. The server runs this on whatever the browser sends. */\n  function cleanSettings(s) {\n    s = s || {};\n    return {\n      detail: Math.round(clamp(s.detail, 60, 1500, 1500)),\n      smooth: !!s.smooth,\n      blend: BLENDS[s.blend] ? s.blend : \"luminosity\",\n      strength: clamp(s.strength, 0.05, 0.9, 0.45),\n      zoom: clamp(s.zoom, 0.6, 3, 1),\n      posX: clamp(s.posX, 0, 1, 0.5),\n      posY: clamp(s.posY, 0, 1, 0.5),\n      edgeFade: s.edgeFade !== false,\n      finish: s.finish !== false,\n      /* Captions keep Latin letters, digits and common punctuation: the characters the embedded caption font\n         carries, so the preview and the delivered file can never differ. */\n      caption: String(s.caption == null ? \"\" : s.caption).replace(/[\\u0000-\\u001f]/g, \" \")\n        .replace(/[^\\u0020-\\u007e\\u00a0-\\u024f\\u2013\\u2014\\u2018\\u2019\\u201c\\u201d\\u2022]/g, \"\").trim().slice(0, 60)\n    };\n  }\n  function cleanColors(colors, max) {\n    if (!Array.isArray(colors) || colors.length < 1 || colors.length > (max || 1500)) return null;\n    var out = [];\n    for (var i = 0; i < colors.length; i++) {\n      var c = colors[i];\n      if (!Array.isArray(c) || c.length !== 3) return null;\n      out.push([Math.round(clamp(c[0], 0, 255, 0)), Math.round(clamp(c[1], 0, 255, 0)), Math.round(clamp(c[2], 0, 255, 0))]);\n    }\n    return out;\n  }\n\n  function bucket(colors, n) {\n    var L = colors.length; if (n >= L) return colors;\n    var out = [];\n    for (var g = 0; g < n; g++) {\n      var s = Math.floor(g * L / n), e = Math.max(s + 1, Math.floor((g + 1) * L / n)), r = 0, gg = 0, b = 0;\n      for (var i = s; i < e; i++) { r += colors[i][0]; gg += colors[i][1]; b += colors[i][2]; }\n      var m = e - s; out.push([Math.round(r / m), Math.round(gg / m), Math.round(b / m)]);\n    }\n    return out;\n  }\n\n  function render(canvas, design, photo, opts) {\n    opts = opts || {};\n    var W = canvas.width, H = canvas.height, ctx = canvas.getContext(\"2d\"), s = cleanSettings(design.settings);\n    var cols = bucket(design.colors || [], s.detail), n = cols.length;\n    var captionFont = opts.captionFont || \"'IBM Plex Sans', 'Segoe UI', sans-serif\";\n\n    ctx.globalAlpha = 1; ctx.globalCompositeOperation = \"source-over\";\n    ctx.fillStyle = \"#000\"; ctx.fillRect(0, 0, W, H);\n\n    if (n) {\n      if (s.smooth) {\n        var grad = ctx.createLinearGradient(0, 0, W, 0);\n        for (var i = 0; i < n; i++) grad.addColorStop((i + 0.5) / n, \"rgb(\" + cols[i].join(\",\") + \")\");\n        ctx.fillStyle = grad; ctx.fillRect(0, 0, W, H);\n      } else {\n        for (var k = 0; k < n; k++) {\n          var x0 = Math.round(k * W / n), x1 = Math.round((k + 1) * W / n);\n          ctx.fillStyle = \"rgb(\" + cols[k].join(\",\") + \")\"; ctx.fillRect(x0, 0, x1 - x0, H);\n        }\n      }\n    }\n\n    if (photo) {\n      var iw = photo.naturalWidth || photo.width, ih = photo.naturalHeight || photo.height;\n      var layer = opts.makeCanvas(W, H), lc = layer.getContext(\"2d\");\n      /* Photo fills the canvas height at zoom 1. Position moves its center, with travel at every zoom. */\n      var sc = (H / ih) * s.zoom, dw = iw * sc, dh = ih * sc;\n      var rx = Math.abs(W - dw) / 2 + W * 0.25, ry = Math.abs(H - dh) / 2 + H * 0.25;\n      var dx = W / 2 + (s.posX - 0.5) * 2 * rx - dw / 2, dy = H / 2 + (s.posY - 0.5) * 2 * ry - dh / 2;\n      lc.drawImage(photo, dx, dy, dw, dh);\n      if (s.edgeFade) {\n        var m = lc.createLinearGradient(dx, 0, dx + dw, 0);\n        m.addColorStop(0, \"rgba(0,0,0,0)\"); m.addColorStop(0.22, \"rgba(0,0,0,1)\");\n        m.addColorStop(0.78, \"rgba(0,0,0,1)\"); m.addColorStop(1, \"rgba(0,0,0,0)\");\n        lc.globalCompositeOperation = \"destination-in\"; lc.fillStyle = m; lc.fillRect(0, 0, W, H);\n        /* Same at the photo's own top and bottom, so a photo moved or shrunk inside the canvas never shows a hard edge. */\n        var mv = lc.createLinearGradient(0, dy, 0, dy + dh);\n        mv.addColorStop(0, \"rgba(0,0,0,0)\"); mv.addColorStop(0.14, \"rgba(0,0,0,1)\");\n        mv.addColorStop(0.86, \"rgba(0,0,0,1)\"); mv.addColorStop(1, \"rgba(0,0,0,0)\");\n        lc.fillStyle = mv; lc.fillRect(0, 0, W, H);\n      }\n      ctx.globalAlpha = s.strength; ctx.globalCompositeOperation = s.blend;\n      ctx.drawImage(layer, 0, 0);\n      ctx.globalAlpha = 1; ctx.globalCompositeOperation = \"source-over\";\n    }\n\n    if (s.finish) {\n      /* Frome finish: stripes glow in the middle band and fall away to dark at the top and bottom. */\n      var f = ctx.createLinearGradient(0, 0, 0, H);\n      [[0, .82], [.1, .52], [.26, .14], [.4, 0], [.6, 0], [.74, .14], [.9, .52], [1, .82]].forEach(function (st) {\n        f.addColorStop(st[0], \"rgba(0,0,0,\" + st[1] + \")\");\n      });\n      ctx.fillStyle = f; ctx.fillRect(0, 0, W, H);\n    }\n\n    if (s.caption) {\n      var size = Math.round(H * 0.042), text = s.caption.toUpperCase(), gap = size * 0.22;\n      ctx.font = \"600 \" + size + \"px \" + captionFont;\n      ctx.textBaseline = \"alphabetic\"; ctx.textAlign = \"left\";\n      ctx.shadowColor = \"rgba(0,0,0,.55)\"; ctx.shadowBlur = size * 0.6;\n      ctx.fillStyle = \"rgba(255,255,255,.94)\";\n      /* Letter spacing is laid out by hand so every browser and the server space the caption identically. */\n      var chars = Array.from(text), widths = [], total = 0, c;\n      for (c = 0; c < chars.length; c++) { widths[c] = ctx.measureText(chars[c]).width; total += widths[c]; }\n      total += gap * Math.max(0, chars.length - 1);\n      var x = (W - total) / 2, y = H - size * 1.5;\n      for (c = 0; c < chars.length; c++) { ctx.fillText(chars[c], x, y); x += widths[c] + gap; }\n      ctx.shadowBlur = 0; ctx.shadowColor = \"transparent\";\n    }\n\n    if (opts.watermark) {\n      ctx.save();\n      ctx.translate(W / 2, H / 2); ctx.rotate(-Math.PI / 9);\n      ctx.font = \"700 \" + Math.round(H * 0.09) + \"px \" + (opts.watermarkFont || \"'Bricolage Grotesque', sans-serif\");\n      ctx.textAlign = \"center\"; ctx.fillStyle = \"rgba(255,255,255,.22)\";\n      for (var wy = -2; wy <= 2; wy++) for (var wx = -2; wx <= 2; wx++) ctx.fillText(\"FROME PREVIEW\", wx * W * 0.42, wy * H * 0.34);\n      ctx.restore();\n    }\n    return canvas;\n  }\n\n  return { render: render, cleanSettings: cleanSettings, cleanColors: cleanColors, bucket: bucket };\n});\n<\/s